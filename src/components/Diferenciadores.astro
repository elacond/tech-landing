---
---
<section id="diferenciadores" class="diff-section scroll-timeline-anchor">

  <div class="diff-flow-bg" aria-hidden="true">
    <svg class="diff-flow-svg" viewBox="0 0 1200 380" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="300"  cy="250" rx="200" ry="130" fill="rgba(1,125,212,0.045)"/>
      <ellipse cx="820"  cy="140" rx="240" ry="110" fill="rgba(1,125,212,0.035)"/>
      <ellipse cx="1100" cy="200" rx="180" ry="90"  fill="rgba(72,167,242,0.03)"/>

      <path class="df df-1" d="M-100,360 C200,280 500,140 760,180 C960,208 1100,60 1300,0"/>
      <path class="df df-2" d="M-100,400 C160,318 430,200 690,218 C900,234 1070,110 1300,42"/>
      <path class="df df-3" d="M-100,320 C240,240 560,80 820,138 C1018,180 1142,20 1300,-28"/>
      <path class="df df-acc" d="M-100,338 C220,256 545,98 808,158 C1000,196 1120,40 1300,-8"/>

      <circle class="df-dot dfd-1" cx="240"  cy="308" r="3"   fill="#48a7f2"/>
      <circle class="df-dot dfd-2" cx="590"  cy="176" r="2.5" fill="#017dd4"/>
      <circle class="df-dot dfd-3" cx="910"  cy="152" r="3"   fill="#48a7f2"/>
      <circle class="df-dot dfd-4" cx="1155" cy="58"  r="2"   fill="#017dd4"/>
    </svg>
  </div>

  <div class="diff-content">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Venimos del terreno operativo, no solo del código.</h2>
      <p class="section-subtitle">Nuestra experiencia combina el desarrollo técnico avanzado con la comprensión profunda de procesos logísticos, industriales y financieros.</p>
    </div>

    <div class="grid diff-grid">
      <article class="diff-card diff-card-1">
        <div class="diff-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="diff-icon"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line></svg>
        </div>
        <h3 class="diff-card-title">Experiencia Dual <br><span class="text-serif">(Físico + Digital)</span></h3>
        <p class="diff-card-desc">Entendemos la cadena de suministro, la logística y la operación en el terreno real. Traducimos tus necesidades físicas en código de software escalable.</p>
      </article>

      <article class="diff-card diff-card-2">
        <div class="diff-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="diff-icon"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
        </div>
        <h3 class="diff-card-title">Arquitectura Pensada <br><span class="text-serif">para Crecer</span></h3>
        <p class="diff-card-desc">Diseñamos tu software con bases de datos y microservicios modulares desde el día uno. Evitamos la deuda técnica para que tu plataforma crezca sin cuellos de botella.</p>
      </article>

      <article class="diff-card diff-card-3">
        <div class="diff-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="diff-icon"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        </div>
        <h3 class="diff-card-title">Soporte Técnico <br><span class="text-serif">Post-Lanzamiento Real</span></h3>
        <p class="diff-card-desc">Contacto directo con quienes construyeron tu proyecto. No desaparecemos tras la entrega; nos integramos como tu equipo de soporte continuado.</p>
      </article>
    </div>
  </div>
  </div>
</section>

<script>
  if (!CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
    const cards = document.querySelectorAll('.diff-card');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('js-reveal-active');
        }
      });
    }, { threshold: 0.15 });

    cards.forEach(card => {
      card.classList.add('js-reveal');
      observer.observe(card);
    });
  }
</script>

<style>
  .diff-section {
    position: relative;
    overflow: hidden;
    padding: var(--space-xl) 0;
    background-color: var(--color-muted-light);
    border-top: 1px solid rgba(44, 34, 30, 0.05);
    border-bottom: 1px solid rgba(44, 34, 30, 0.05);
    view-timeline: --diff-timeline block;
  }

  .diff-flow-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .diff-flow-svg { width: 100%; height: 100%; }

  .diff-content {
    position: relative;
    z-index: 1;
  }

  .df {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1900;
    stroke-dashoffset: 1900;
  }
  .df-1   { stroke: #017dd4; stroke-width: 2;   filter: drop-shadow(0 0 7px rgba(1,125,212,0.55)); }
  .df-2   { stroke: #017dd4; stroke-width: 1.5; opacity: 0.35; }
  .df-3   { stroke: #48a7f2; stroke-width: 1;   opacity: 0.22; }
  .df-acc { stroke: #48a7f2; stroke-width: 1.5; filter: drop-shadow(0 0 10px rgba(72,167,242,0.7)); }

  @keyframes dfDraw {
    0%   { stroke-dashoffset: 1900; opacity: 0; }
    6%   { opacity: 0.9; }
    88%  { opacity: 0.7; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  .df-dot { opacity: 0; filter: drop-shadow(0 0 4px #48a7f2); }
  @keyframes dfDot {
    0%, 100% { opacity: 0; }
    50%       { opacity: 0.85; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .df-1   { animation: dfDraw 7s ease-in-out 0s    infinite; }
    .df-2   { animation: dfDraw 7s ease-in-out 1s    infinite; }
    .df-3   { animation: dfDraw 7s ease-in-out 1.9s  infinite; }
    .df-acc { animation: dfDraw 7s ease-in-out 0.5s  infinite; }
    .dfd-1  { animation: dfDot  2.5s ease-in-out 2s   infinite; }
    .dfd-2  { animation: dfDot  2.5s ease-in-out 2.9s infinite; }
    .dfd-3  { animation: dfDot  2.5s ease-in-out 3.8s infinite; }
    .dfd-4  { animation: dfDot  2.5s ease-in-out 4.7s infinite; }
  }

  .section-badge {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  .diff-grid {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-md);
  }

  .diff-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-muted);
    border-radius: var(--border-radius);
    padding: 3rem 2.25rem;
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    will-change: transform, opacity;
  }

  .diff-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--box-shadow-hover);
    border-color: var(--color-primary);
  }

  .diff-icon-wrapper {
    background-color: rgba(1, 125, 212, 0.08);
    color: var(--color-primary);
    width: 52px;
    height: 52px;
    border-radius: var(--border-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .diff-icon {
    width: 24px;
    height: 24px;
  }

  .diff-card-title {
    font-size: 1.45rem;
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .text-serif {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
  }

  .diff-card-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @keyframes diffReveal {
    from {
      opacity: 0;
      transform: translateY(60px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .diff-card {
        animation: diffReveal auto linear both;
        animation-timeline: --diff-timeline;
      }

      .diff-card-1 {
        animation-range: entry 5% entry 40%;
      }
      .diff-card-2 {
        animation-range: entry 15% entry 50%;
      }
      .diff-card-3 {
        animation-range: entry 25% entry 60%;
      }
    }
  }

  .diff-card.js-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .diff-card.js-reveal-active {
    opacity: 1;
    transform: translateY(0);
  }
</style>
