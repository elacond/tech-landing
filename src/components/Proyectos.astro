---
import { Image } from 'astro:assets'

import elacond from '../assets/elacond.png'
import elacondApp from '../assets/elacond-app.png'
import edgar from '../assets/edgarfigueroa.png'
import kipo from '../assets/kipo.png'
import handyman from '../assets/handyman.png'
---
<section id="proyectos" class="proyectos-section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">PROYECTOS REALIZADOS</span>
      <h2 class="section-title">Software que ya opera en campo.</h2>
    </div>

    <div class="proyectos-grid">

      <article class="proj-card proj-kipo" >
        <a href="https://www.kipo.com.mx/" target="_blank" rel="noopener noreferrer" class="proj-link" aria-label="Ver proyecto Kipo">
          <div class="proj-img-wrap">
            <Image
              src={kipo}
              alt="Landing de Kipo — plataforma de facturacion CFDI 4.0"
              class="proj-img"
              width="800" height="460"
              loading="lazy"
              decoding="async"
            />
            <div class="proj-hover-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              kipo.com.mx
            </div>
            <span class="proj-status-pill">Plataforma en desarrollo</span>
          </div>
          <div class="proj-meta">
            <span class="proj-tag">SaaS / Facturacion CFDI 4.0</span>
            <h3 class="proj-name">Kipo</h3>
            <p class="proj-desc">Plataforma de facturacion electronica CFDI 4.0 para freelancers, talleres y negocios mexicanos. Landing de captura ya en linea; plataforma web en desarrollo activo.</p>
          </div>
        </a>
      </article>

      <article class="proj-card proj-handyman">
        <a href="https://www.handymanmunoz.com/" target="_blank" rel="noopener noreferrer" class="proj-link" aria-label="Ver proyecto Handyman Munoz">
          <div class="proj-img-wrap">
            <Image
              src={handyman}
              alt="Vista previa de handymanmunoz.com"
              class="proj-img"
              width="600" height="380"
              loading="lazy"
              decoding="async"
            />
            <div class="proj-hover-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              handymanmunoz.com
            </div>
          </div>
          <div class="proj-meta">
            <span class="proj-tag">Sitio Corporativo</span>
            <h3 class="proj-name">Handyman Munoz</h3>
            <p class="proj-desc">Sitio de servicios al hogar con formulario de cotizacion y galeria de trabajos realizados.</p>
          </div>
        </a>
      </article>

      <article class="proj-card proj-elacond">
        <a href="https://www.elacond.com/" target="_blank" rel="noopener noreferrer" class="proj-link" aria-label="Ver proyecto Elacond">
          <div class="proj-img-wrap">
            <Image
              src={elacond}
              alt="Vista previa de elacond.com — servicios de AC"
              class="proj-img"
              width="600" height="380"
              loading="lazy"
              decoding="async"
            />
            <div class="proj-hover-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              elacond.com
            </div>
          </div>
          <div class="proj-meta">
            <span class="proj-tag">Sitio Corporativo</span>
            <h3 class="proj-name">Elacond</h3>
            <p class="proj-desc">Presencia digital para empresa de mantenimiento e instalaciones de AC. Catalogo de servicios y generacion de leads.</p>
          </div>
        </a>
      </article>

      <article class="proj-card proj-app proj-private">
        <div class="proj-link-no-href">
          <div class="proj-img-wrap proj-img-private">
            <Image
              src={elacondApp}
              alt="Portfolio de Edgar Figueroa — Software Engineer"
              class="proj-img"
              width="600" height="380"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="proj-meta">
            <span class="proj-tag">App Movil</span>
            <h3 class="proj-name">App de Reportes de Instalacion</h3>
            <p class="proj-desc">Aplicacion movil para captura y seguimiento de reportes de instalacion y mantenimiento en campo. Estados de avance, firma digital y exportacion de reportes por tecnico.</p>
          </div>
        </div>
      </article>

      <article class="proj-card proj-edgar">
        <a href="https://edgarfigueroa.info" target="_blank" rel="noopener noreferrer" class="proj-link" aria-label="Ver portfolio de Edgar Figueroa">
          <div class="proj-img-wrap">
            <Image
              src={edgar}
              alt="Portfolio de Edgar Figueroa — Software Engineer"
              class="proj-img"
              width="600" height="380"
              loading="lazy"
              decoding="async"
            />
            <div class="proj-hover-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              edgarfigueroa.info
            </div>
          </div>
          <div class="proj-meta">
            <span class="proj-tag">Portfolio</span>
            <h3 class="proj-name">Edgar Figueroa</h3>
            <p class="proj-desc">Portfolio de ingenieria con proyectos de software, arquitectura tecnica y consultoria.</p>
          </div>
        </a>
      </article>

    </div>
  </div>
</section>

<style>
  .proyectos-section {
    padding: var(--space-xl) 0;
    background-color: var(--color-bg);
    border-bottom: 1px solid rgba(44, 34, 30, 0.05);
  }

  .eyebrow {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  .proyectos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: var(--space-md);
  }

  .proj-kipo     { grid-column: 1 / 3; }
  .proj-handyman { grid-column: 3; }

  .proj-elacond  { grid-column: 1; }
  .proj-app      { grid-column: 2 / 4; }

  .proj-edgar    { grid-column: 1 / 4; }

  .proj-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-muted);
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
  }

  .proj-card:not(.proj-private):hover {
    box-shadow: var(--box-shadow-hover);
    transform: translateY(-4px);
    border-color: rgba(1, 125, 212, 0.25);
  }

  .proj-edgar .proj-link {
    flex-direction: row;
    align-items: stretch;
  }
  .proj-edgar .proj-img-wrap {
    flex: 0 0 55%;
    aspect-ratio: auto;
    min-height: 260px;
  }
  .proj-edgar .proj-meta {
    flex: 1;
    padding: 2.5rem 2.5rem;
    justify-content: center;
  }
  .proj-edgar .proj-name { font-size: 1.75rem; }

  .proj-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .proj-link-no-href {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .proj-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background-color: var(--color-muted-light);
  }

  .proj-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proj-card:hover .proj-img {
    transform: scale(1.04);
  }

  .proj-hover-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    background-color: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    border-radius: 4px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .proj-card:hover .proj-hover-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .proj-status-pill {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.25rem 0.65rem;
    background-color: rgba(1, 125, 212, 0.12);
    border: 1px solid rgba(1, 125, 212, 0.3);
    color: var(--color-primary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .proj-img-private {
    background-color: var(--color-text);
    aspect-ratio: 16 / 8;
  }

  .proj-private-visual {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
  }

  .proj-app-svg {
    width: 100%;
    height: 100%;
    max-height: 220px;
  }

  .proj-private-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    padding: 0.28rem 0.65rem;
    background-color: rgba(202, 210, 197, 0.1);
    border: 1px solid rgba(202, 210, 197, 0.22);
    color: rgba(202, 210, 197, 0.65);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .proj-meta {
    padding: 1.4rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .proj-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.55rem;
  }

  .proj-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
    margin-bottom: 0.55rem;
  }

  .proj-desc {
    font-size: 0.87rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .proj-kipo,
    .proj-handyman,
    .proj-elacond,
    .proj-app,
    .proj-edgar { grid-column: 1 / -1; }

    .proj-edgar .proj-link { flex-direction: column; }
    .proj-edgar .proj-img-wrap { flex: none; aspect-ratio: 16 / 10; min-height: auto; }
    .proj-edgar .proj-meta { padding: 1.4rem 1.75rem 1.75rem; }
    .proj-edgar .proj-name { font-size: 1.2rem; }
  }

  @keyframes projReveal {
    from { opacity: 0; transform: translateY(36px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .proyectos-section { view-timeline: --proyectos-tl block; }
      .proj-card {
        animation: projReveal auto linear both;
        animation-timeline: --proyectos-tl;
      }
      .proj-card:nth-child(1) { animation-range: entry 5%  entry 40%; }
      .proj-card:nth-child(2) { animation-range: entry 12% entry 47%; }
      .proj-card:nth-child(3) { animation-range: entry 22% entry 54%; }
      .proj-card:nth-child(4) { animation-range: entry 30% entry 60%; }
      .proj-card:nth-child(5) { animation-range: entry 40% entry 68%; }
    }
  }
</style>
