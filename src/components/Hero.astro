---
---
<section id="hero" class="hero-section">

  <div class="hero-bg-flow" aria-hidden="true">
    <svg class="flow-svg" viewBox="0 0 700 580" preserveAspectRatio="xMaxYMid meet" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hgrid" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" fill="rgba(1,125,212,0.10)"/>
        </pattern>
        <filter id="hglow" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>

      <rect width="700" height="580" fill="url(#hgrid)"/>

      <path class="ctrace" d="M -20,160 L 140,160 L 140,80  L 300,80  L 300,180 L 420,180"/>
      <path class="ctrace" d="M 540,0   L 540,100 L 420,100 L 420,220 L 340,220 L 340,320"/>
      <path class="ctrace" d="M 700,260 L 580,260 L 580,180 L 480,180 L 480,100 L 620,100 L 620,40"/>
      <path class="ctrace" d="M 700,480 L 560,480 L 560,380 L 660,380 L 660,300 L 520,300"/>
      <path class="ctrace" d="M 340,460 L 480,460 L 480,360 L 580,360"/>
      <path class="ctrace" d="M -20,380 L 100,380 L 100,300 L 220,300 L 220,420 L 340,420"/>

      <circle class="jnode" cx="140" cy="160" r="3.5"/>
      <circle class="jnode" cx="140" cy="80"  r="3"/>
      <circle class="jnode" cx="300" cy="80"  r="4"/>
      <circle class="jnode" cx="300" cy="180" r="3"/>
      <circle class="jnode" cx="420" cy="180" r="3.5"/>
      <circle class="jnode" cx="540" cy="100" r="4"/>
      <circle class="jnode" cx="420" cy="100" r="3"/>
      <circle class="jnode" cx="420" cy="220" r="4"/>
      <circle class="jnode" cx="340" cy="220" r="3"/>
      <circle class="jnode" cx="580" cy="260" r="3.5"/>
      <circle class="jnode" cx="580" cy="180" r="3"/>
      <circle class="jnode" cx="480" cy="180" r="4"/>
      <circle class="jnode" cx="480" cy="100" r="3"/>
      <circle class="jnode" cx="560" cy="480" r="3.5"/>
      <circle class="jnode" cx="560" cy="380" r="3"/>
      <circle class="jnode" cx="660" cy="380" r="4"/>
      <circle class="jnode" cx="480" cy="460" r="3.5"/>
      <circle class="jnode" cx="480" cy="360" r="3"/>
      <circle class="jnode" cx="100" cy="380" r="3"/>
      <circle class="jnode" cx="220" cy="300" r="4"/>
      <circle class="jnode" cx="220" cy="420" r="3"/>

      <g filter="url(#hglow)">
        <circle r="5" fill="#017dd4" opacity="0">
          <animateMotion path="M -20,160 L 140,160 L 140,80 L 300,80 L 300,180 L 420,180" dur="3.2s" begin="0s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;0.8;0.8;0" keyTimes="0;0.05;0.12;0.88;1" dur="3.2s" begin="0s" repeatCount="indefinite"/>
        </circle>
        <circle r="2" fill="white" opacity="0">
          <animateMotion path="M -20,160 L 140,160 L 140,80 L 300,80 L 300,180 L 420,180" dur="3.2s" begin="0s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.08;0.15;0.88;1" dur="3.2s" begin="0s" repeatCount="indefinite"/>
        </circle>
      </g>
      <g filter="url(#hglow)">
        <circle r="5" fill="#017dd4" opacity="0">
          <animateMotion path="M 540,0 L 540,100 L 420,100 L 420,220 L 340,220 L 340,320" dur="2.8s" begin="0.9s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;0.8;0.8;0" keyTimes="0;0.05;0.12;0.88;1" dur="2.8s" begin="0.9s" repeatCount="indefinite"/>
        </circle>
        <circle r="2" fill="white" opacity="0">
          <animateMotion path="M 540,0 L 540,100 L 420,100 L 420,220 L 340,220 L 340,320" dur="2.8s" begin="0.9s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.08;0.15;0.88;1" dur="2.8s" begin="0.9s" repeatCount="indefinite"/>
        </circle>
      </g>
      <g filter="url(#hglow)">
        <circle r="5" fill="#017dd4" opacity="0">
          <animateMotion path="M 700,260 L 580,260 L 580,180 L 480,180 L 480,100 L 620,100 L 620,40" dur="3.5s" begin="1.6s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;0.8;0.8;0" keyTimes="0;0.05;0.12;0.88;1" dur="3.5s" begin="1.6s" repeatCount="indefinite"/>
        </circle>
        <circle r="2" fill="white" opacity="0">
          <animateMotion path="M 700,260 L 580,260 L 580,180 L 480,180 L 480,100 L 620,100 L 620,40" dur="3.5s" begin="1.6s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.08;0.15;0.88;1" dur="3.5s" begin="1.6s" repeatCount="indefinite"/>
        </circle>
      </g>
      <g filter="url(#hglow)">
        <circle r="5" fill="#017dd4" opacity="0">
          <animateMotion path="M 700,480 L 560,480 L 560,380 L 660,380 L 660,300 L 520,300" dur="3.0s" begin="2.3s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;0.8;0.8;0" keyTimes="0;0.05;0.12;0.88;1" dur="3.0s" begin="2.3s" repeatCount="indefinite"/>
        </circle>
        <circle r="2" fill="white" opacity="0">
          <animateMotion path="M 700,480 L 560,480 L 560,380 L 660,380 L 660,300 L 520,300" dur="3.0s" begin="2.3s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.08;0.15;0.88;1" dur="3.0s" begin="2.3s" repeatCount="indefinite"/>
        </circle>
      </g>
      <g filter="url(#hglow)">
        <circle r="4" fill="#48a7f2" opacity="0">
          <animateMotion path="M 340,460 L 480,460 L 480,360 L 580,360" dur="2.4s" begin="1.1s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;0.7;0.7;0" keyTimes="0;0.05;0.12;0.88;1" dur="2.4s" begin="1.1s" repeatCount="indefinite"/>
        </circle>
        <circle r="1.5" fill="white" opacity="0">
          <animateMotion path="M 340,460 L 480,460 L 480,360 L 580,360" dur="2.4s" begin="1.1s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.08;0.15;0.88;1" dur="2.4s" begin="1.1s" repeatCount="indefinite"/>
        </circle>
      </g>
      <g filter="url(#hglow)">
        <circle r="4" fill="#48a7f2" opacity="0">
          <animateMotion path="M -20,380 L 100,380 L 100,300 L 220,300 L 220,420 L 340,420" dur="3.3s" begin="0.5s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;0.65;0.65;0" keyTimes="0;0.05;0.12;0.88;1" dur="3.3s" begin="0.5s" repeatCount="indefinite"/>
        </circle>
        <circle r="1.5" fill="white" opacity="0">
          <animateMotion path="M -20,380 L 100,380 L 100,300 L 220,300 L 220,420 L 340,420" dur="3.3s" begin="0.5s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.08;0.15;0.88;1" dur="3.3s" begin="0.5s" repeatCount="indefinite"/>
        </circle>
      </g>
    </svg>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <span class="eyebrow">INGENIERÍA DE SOFTWARE Y CONSULTORÍA</span>
      <h1 class="hero-title">
        <span class="block-text">Software a medida</span>
        <span class="block-text indent text-primary">pensado para la escala</span>
        <span class="block-text">de tus operaciones reales.</span>
      </h1>
      <p class="hero-subtitle">
        Diseñamos y desarrollamos plataformas SaaS, sitios web de alta conversión e infraestructura tecnológica sólida. Sin cajas negras. Con soporte técnico continuo y procesos transparentes de principio a fin.
      </p>
      <div class="hero-actions">
        <a href="#pricing" class="btn btn-primary">Ver Modelos de Trabajo</a>
      </div>
    </div>

    <div class="hero-visual" id="js-hero-visual-container">
      <div class="tech-card-wrapper" id="js-tilt-card">
        <div class="mock-panel">
          <div class="mock-panel-header">
            <div class="mock-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="mock-title">panel.rendimiento</div>
          </div>
          <div class="mock-panel-body">
            <div class="mock-stat-grid">
              <div class="mock-stat-card">
                <span class="mock-stat-label">Eficiencia Operativa</span>
                <span class="mock-stat-val">+42.8%</span>
                <span class="mock-stat-indicator"></span>
              </div>
              <div class="mock-stat-card">
                <span class="mock-stat-label">Soporte Activo</span>
                <span class="mock-stat-val">24/7/365</span>
                <span class="mock-stat-indicator active"></span>
              </div>
            </div>

            <div class="mock-dashboard">
              <svg viewBox="0 0 296 168" xmlns="http://www.w3.org/2000/svg" aria-label="Gráfico de eficiencia operativa mensual">
                <!-- Background -->
                <rect width="296" height="168" rx="6" fill="#FAF6F0"/>

                <!-- Section label -->
                <text x="12" y="16" font-size="7" font-weight="700" fill="#5e4e47" font-family="system-ui,sans-serif" letter-spacing="1.2">EFICIENCIA OPERATIVA</text>
                <text x="284" y="16" text-anchor="end" font-size="7" fill="#CAD2C5" font-family="system-ui,sans-serif">6 meses</text>

                <!-- Grid lines -->
                <line x1="12" y1="28"  x2="272" y2="28"  stroke="#e5e9e2" stroke-width="0.75"/>
                <line x1="12" y1="54"  x2="272" y2="54"  stroke="#e5e9e2" stroke-width="0.75"/>
                <line x1="12" y1="80"  x2="272" y2="80"  stroke="#e5e9e2" stroke-width="0.75"/>
                <line x1="12" y1="106" x2="272" y2="106" stroke="#e5e9e2" stroke-width="0.75"/>

                <!-- Y-axis labels -->
                <text x="278" y="31"  font-size="6.5" fill="#CAD2C5" font-family="system-ui,sans-serif">100%</text>
                <text x="278" y="57"  font-size="6.5" fill="#CAD2C5" font-family="system-ui,sans-serif">75%</text>
                <text x="278" y="83"  font-size="6.5" fill="#CAD2C5" font-family="system-ui,sans-serif">50%</text>
                <text x="278" y="109" font-size="6.5" fill="#CAD2C5" font-family="system-ui,sans-serif">25%</text>

                <!-- Bars (baseline y=106, chart height=78) -->
                <rect x="16"  y="89" width="26" height="17" rx="3" fill="#e5e9e2"/>
                <rect x="56"  y="76" width="26" height="30" rx="3" fill="#e5e9e2"/>
                <rect x="96"  y="65" width="26" height="41" rx="3" fill="#CAD2C5"/>
                <rect x="136" y="54" width="26" height="52" rx="3" fill="#48a7f2"/>
                <rect x="176" y="41" width="26" height="65" rx="3" fill="#017dd4"/>
                <rect x="216" y="28" width="26" height="78" rx="3" fill="#017dd4"/>

                <!-- Badge on last bar -->
                <rect x="204" y="18" width="50" height="14" rx="4" fill="#017dd4"/>
                <text x="229" y="28" text-anchor="middle" font-size="7.5" font-weight="700" fill="white" font-family="system-ui,sans-serif">+42.8%</text>

                <!-- Trend line -->
                <polyline
                  points="29,89 69,76 109,65 149,54 189,41 229,28"
                  fill="none" stroke="#D66853" stroke-width="1.5"
                  stroke-dasharray="3,2" stroke-linecap="round" stroke-linejoin="round"
                />
                <circle cx="29"  cy="89" r="2.5" fill="#D66853"/>
                <circle cx="229" cy="28" r="3"   fill="#D66853"/>

                <!-- Month labels -->
                <text x="29"  y="118" text-anchor="middle" font-size="7" fill="#5e4e47" font-family="system-ui,sans-serif">Ene</text>
                <text x="69"  y="118" text-anchor="middle" font-size="7" fill="#5e4e47" font-family="system-ui,sans-serif">Feb</text>
                <text x="109" y="118" text-anchor="middle" font-size="7" fill="#5e4e47" font-family="system-ui,sans-serif">Mar</text>
                <text x="149" y="118" text-anchor="middle" font-size="7" fill="#5e4e47" font-family="system-ui,sans-serif">Abr</text>
                <text x="189" y="118" text-anchor="middle" font-size="7" fill="#5e4e47" font-family="system-ui,sans-serif">May</text>
                <text x="229" y="118" text-anchor="middle" font-size="7" fill="#017dd4" font-family="system-ui,sans-serif" font-weight="700">Jun</text>

                <!-- Divider -->
                <line x1="12" y1="126" x2="284" y2="126" stroke="#e5e9e2" stroke-width="1"/>

                <!-- Summary KPIs -->
                <rect x="12"  y="133" width="126" height="26" rx="5" fill="rgba(1,125,212,0.07)"/>
                <text x="20"  y="143" font-size="6.5" fill="#5e4e47" font-family="system-ui,sans-serif" font-weight="600">Ahorro proyectado anual</text>
                <text x="20"  y="154" font-size="9.5" fill="#017dd4" font-family="system-ui,sans-serif" font-weight="700">$28,800 USD</text>

                <rect x="148" y="133" width="124" height="26" rx="5" fill="rgba(214,104,83,0.07)"/>
                <text x="156" y="143" font-size="6.5" fill="#5e4e47" font-family="system-ui,sans-serif" font-weight="600">Horas recuperadas / mes</text>
                <text x="156" y="154" font-size="9.5" fill="#D66853" font-family="system-ui,sans-serif" font-weight="700">144 horas</text>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('js-hero-visual-container');
  const card = document.getElementById('js-tilt-card');

  if (container && card && window.matchMedia("(pointer: fine)").matches) {
    container.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      const x = e.clientX - rect.left; // x position within the container
      const y = e.clientY - rect.top;  // y position within the container

      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = (centerY - y) / 10; // Max tilt vertical
      const rotateY = (x - centerX) / 10; // Max tilt horizontal

      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
    });

    container.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(4deg) rotateY(-8deg) scale3d(1, 1, 1)';
    });
  }
</script>

<style>
  .hero-section {
    position: relative;
    padding-top: calc(var(--header-height) + var(--space-md));
    padding-bottom: var(--space-xl);
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg-flow {
    position: absolute;
    right: -3%;
    bottom: -8%;
    width: 62%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .flow-svg {
    width: 100%;
    height: 100%;
  }

  .ctrace {
    fill: none;
    stroke: #017dd4;
    stroke-width: 1;
    stroke-linecap: square;
    stroke-linejoin: miter;
    opacity: 0.18;
  }

  .jnode {
    fill: #017dd4;
    opacity: 0.28;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-flow svg g[filter] { display: none; }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero-content {
    max-width: 720px;
    z-index: 10;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: var(--space-md);
  }

  .block-text {
    display: block;
  }

  .block-text.indent {
    padding-left: clamp(2rem, 6vw, 5rem);
    font-style: italic;
    font-weight: 400;
  }

  .text-primary {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Hero UI Visual */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    perspective: 1000px;
  }

  .tech-card-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
    transform: perspective(1000px) rotateX(4deg) rotateY(-8deg);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .mock-panel {
    background-color: var(--color-white);
    border: 1px solid var(--color-muted);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow-hover);
    overflow: hidden;
    width: 100%;
  }

  .mock-panel-header {
    background-color: var(--color-muted-light);
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgba(44, 34, 30, 0.08);
  }

  .mock-dots {
    display: flex;
    gap: 7px;
  }

  .mock-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--color-muted);
  }

  .mock-title {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .mock-panel-body {
    padding: 1.75rem;
  }

  .mock-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .mock-stat-card {
    border: 1px solid var(--color-muted-light);
    border-radius: 8px;
    padding: 1rem;
    background-color: var(--color-bg);
    position: relative;
  }

  .mock-stat-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .mock-stat-val {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .mock-stat-indicator {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-muted);
  }

  .mock-stat-indicator.active {
    background-color: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
    animation: statPulse 2s infinite alternate;
  }

  @keyframes statPulse {
    0% { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.2); opacity: 1; }
  }

  .mock-dashboard {
    border: 1px solid var(--color-muted-light);
    border-radius: 8px;
    overflow: hidden;
  }

  .mock-dashboard svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      text-align: center;
    }

    .hero-content {
      margin: 0 auto;
    }

    .block-text.indent {
      padding-left: 0;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      order: -1;
      margin-bottom: var(--space-md);
    }

    .tech-card-wrapper {
      transform: none !important; /* Disable 3D tilt on mobile */
    }
  }
</style>
